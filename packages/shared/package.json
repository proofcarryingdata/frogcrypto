{
  "name": "@frogcrypto/shared",
  "version": "0.0.2",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --onSuccess 'tsc --emitDeclarationOnly --declaration --declarationMap'",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "jest": {
    "preset": "@frogcrypto/jest-presets/node"
  },
  "devDependencies": {
    "@frogcrypto/eslint-config": "workspace:*",
    "@frogcrypto/jest-presets": "workspace:*",
    "@frogcrypto/typescript-config": "workspace:*",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.7",
    "@types/node": "^20.11.24",
    "jest": "^29.7.0",
    "tsup": "8.3.0",
    "typescript": "~5.5.4"
  },
  "dependencies": {
    "@parcnet-js/podspec": "1.2.0",
    "@parcnet-js/ticket-spec": "1.1.9",
    "@pcd/pod": "0.5.0",
    "@semaphore-protocol/identity": "^4.2.0",
    "@zk-kit/utils": "^1.2.1",
    "lodash": "^4.17.21",
    "loglevel": "^1.9.2",
    "poseidon-lite": "^0.3.0",
    "zod": "^3.23.8"
  }
}
