{
  "name": "@frogcrypto/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "jest": {
    "preset": "@frogcrypto/jest-presets/node"
  },
  "devDependencies": {
    "@frogcrypto/eslint-config": "workspace:*",
    "@frogcrypto/jest-presets": "workspace:*",
    "@frogcrypto/typescript-config": "workspace:*",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "jest": "^29.7.0",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@pcd/pod": "^0.1.5",
    "@semaphore-protocol/identity": "^4.0.3",
    "@zk-kit/utils": "^1.2.1",
    "poseidon-lite": "^0.3.0"
  }
}
