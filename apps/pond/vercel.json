{
  "rewrites": [
    { "source": "/button", "destination": "/button.html" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "redirects": [
    {
      "source": "/redirect/(.*)",
      "destination": "https://frogcrypto-api.vercel.app/redirect/$1"
    },
    {
      "source": "/button/:id",
      "destination": "https://frogcrypto-api.vercel.app/button/:id"
    }
  ]
}
