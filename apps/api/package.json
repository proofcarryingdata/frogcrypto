{
  "name": "@frogcrypto/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsup --watch --onSuccess \"NODE_ENV=development node dist/index.js\"",
    "build": "tsup",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "jest --detectOpenHandles",
    "vercel-build": "pnpm run build && rm index.js",
    "setup-cyberfrog": "tsx src/setup_cyberfrog.ts",
    "loadtest": "tsx src/loadtest.ts"
  },
  "jest": {
    "preset": "@frogcrypto/jest-presets/node"
  },
  "dependencies": {
    "@frogcrypto/shared": "workspace:*",
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "@parcnet-js/podspec": "1.2.0",
    "@pcd/gpc": "^0.0.8",
    "@pcd/gpcircuits": "^0.1.7",
    "@pcd/pod": "0.5.0",
    "@pcd/proto-pod-gpc-artifacts": "^0.11.0",
    "@semaphore-protocol/identity": "^4.2.0",
    "@serialport/parser-readline": "^12.0.0",
    "@trpc/server": "11.0.0-rc.502",
    "@upstash/redis": "^1.34.3",
    "@vercel/postgres": "^0.10.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "express": "^4.18.3",
    "express-handlebars": "^8.0.1",
    "fix-esm": "^1.0.1",
    "hbs": "^4.2.0",
    "lodash": "^4.17.21",
    "morgan": "^1.10.0",
    "serialport": "^12.0.0",
    "superjson": "^1.13.3",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@frogcrypto/eslint-config": "workspace:*",
    "@frogcrypto/jest-presets": "workspace:*",
    "@frogcrypto/typescript-config": "workspace:*",
    "@trpc/client": "11.0.0-rc.502",
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.24",
    "@types/serialport": "^8.0.5",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@zk-kit/utils": "^1.2.1",
    "drizzle-kit": "^0.24.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "tsup": "^8.0.2",
    "tsx": "^4.19.1",
    "typescript": "~5.5.4"
  }
}
